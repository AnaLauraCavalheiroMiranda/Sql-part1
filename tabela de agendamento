SELECT 
    a.id AS id_agendamento,
    c.id AS id_cliente,
    c.nome AS nome_cliente,
    c.gmail AS frequencia_digital,
    CASE 
        WHEN a.estilo_preferencia = 'minimalista' THEN '🌘 Eclipse (Minimalista e Escuro)'
        WHEN a.estilo_preferencia = 'brilhante' THEN '🪐 Saturniano (Anéis e Camadas)'
        WHEN a.estilo_preferencia = 'futurista' THEN '✨ Via Láctea (Brilho e Cristais)'
    END AS armadura_escolhida,
    a.data_solicitacao AS data_sinal,
    a.status_triagem AS status_missao
FROM agendamentos a
INNER JOIN clientes c ON a.cliente_id = c.id
ORDER BY a.id ASC;
